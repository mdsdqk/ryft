# Postgres connection string. A free Neon branch (https://neon.tech) or any local
# Postgres. Used by `pnpm --filter @ryft/api dev` and `drizzle-kit push`.
# Tests do NOT read this — they run on an in-process pglite instance.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Optional — the local dev server port (default 8787).
# PORT=8787
